Algoritmo ConsumoGasolina
	
    Definir kilometros, gasolina, consumo Como Real;
	
    Escribir "Ingrese los kilómetros recorridos:";
    Leer kilometros;
	
    Escribir "Ingrese los litros de gasolina consumidos:";
    Leer gasolina;
	
    consumo <- gasolina / kilometros;
	
    Escribir "El consumo de gasolina por km es: ", consumo, " litros/km";
	
FinAlgoritmo
