Proceso TotalCompra
    Definir cantidad, precio, total Como Real;
    
    Escribir "Ingrese la cantidad de productos:";
    Leer cantidad;
    
    Escribir "Ingrese el precio del producto:";
    Leer precio;
    
    total <- cantidad * precio;
    
    Escribir "El total de la compra es: ", total;
FinProceso
